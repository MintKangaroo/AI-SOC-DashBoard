# ── SOC 대시보드 환경설정 예시 ──
# 실제 값을 채워 .env 로 복사하세요:  cp .env.example .env
# ⚠ .env 는 절대 커밋하지 마세요(.gitignore 에 이미 제외됨).

# ── 서버 ──
HOST=127.0.0.1               # 외부/Tailscale 접속 시 0.0.0.0
PORT=5055
DEBUG=False
SECRET_KEY=change-me-to-a-random-string    # 세션 서명 키(랜덤 고정 권장)

# ── 대시보드 로그인 ──
AUTH_ENABLED=True
DASH_USERNAME=admin
DASH_PASSWORD=change-me                     # 평문(시작 시 해시로 변환) — 또는 아래 해시 사용
# DASH_PASSWORD_HASH=                        # pbkdf2 해시(권장)
SESSION_HOURS=12

# ── 데모 모드 ──
DEMO_MODE=True               # True 면 실제 센서 없이 가상 데이터로 전 기능 동작
DEMO_UPDATE_INTERVAL=2.0     # 데모 데이터 생성 주기(초)

# ── AI (Claude) ──
ANTHROPIC_API_KEY=           # 비우면 규칙 기반 데모 분석으로 fallback
AI_MODEL=claude-sonnet-4-6   # 분석·챗봇에 쓸 모델

# ── 패킷 캡처 / 탐지 임계값 ──
CAPTURE_INTERFACE=           # 비우면 자동 감지
DDOS_PACKET_THRESHOLD=2000
PORT_SCAN_THRESHOLD=40
ALERT_CONFIDENCE_THRESHOLD=0.5
DATA_EXFIL_BYTES_THRESHOLD=500000000  # 내부→외부 5분 누적 500MB
DATA_EXFIL_WINDOW_SECONDS=300
DATA_EXFIL_ALLOWLIST=                 # 승인 목적지 IP/접두, 쉼표 구분
MAX_PACKETS_DISPLAY=200               # 패킷 패널에 유지할 최근 패킷 수

# ── Snort IDS (fast alert) ──
SNORT_ENABLED=True
SNORT_ALERT_PATH=/var/log/snort/snort.alert.fast
SNORT_POLL_INTERVAL=0.5
SNORT_INTERFACE=eth0
SNORT_HOME_NET=172.23.160.0/20
SNORT_BLOCK_EXCLUDED_SIDS=254  # 정상 Tailscale DNS 등 자동 차단 근거 제외 SID

# ── SIEM 접근 로그 수집 (파일 tail) ──
SIEM_ACCESS_LOGS=            # "이름=경로;이름=경로"
SIEM_EXFIL_MIN_BYTES=500000000
SIEM_PROMOTE_ALERTS=True     # SIEM 매칭을 위협 알림으로 승격할지
SIEM_STATE_PATH=data/siem_offsets.json  # 파일 tail 오프셋(재시작 후 이어읽기)
SIGMA_RULES_DIR=data/sigma   # SIGMA 규칙 디렉터리

# ── Syslog 수신 (원격 침해시도) ──
SYSLOG_ENABLED=True
SYSLOG_BIND=127.0.0.1
SYSLOG_PORT=5514             # 514 는 sudo 필요 → 비특권 5514 권장

# ── 허니팟 (유인 서비스) ──
HONEYPOT_ENABLED=True
HONEYPOT_BIND=127.0.0.1      # 실포착은 0.0.0.0 또는 신뢰 네트워크(Tailscale) IP
HONEYPOT_PORTS=              # 비우면 기본셋 2222,2323,3306,6379,8081,9200
HONEYPOT_COOLDOWN=30

# ── SSH 인증 로그 ──
AUTH_LOG_PATH=/var/log/auth.log
SSH_BRUTE_THRESHOLD=5
SSH_BRUTE_WINDOW=120

# ── IP 평판 (AbuseIPDB) ──
ABUSEIPDB_API_KEY=           # 비우면 데모 점수 fallback
ABUSEIPDB_MIN_SCORE=75       # 이 점수 이상을 악성으로 판정
ABUSEIPDB_CACHE_HOURS=6      # 조회 결과 캐시 시간
VIRUSTOTAL_API_KEY=          # 파일 업로드 없이 해시 리포트 조회
VIRUSTOTAL_TIMEOUT=8         # 조회 타임아웃(초)
VIRUSTOTAL_CACHE_HOURS=6     # 해시 평판 캐시 시간

# ── EDR / 네트워크 관제 ──
EDR_RESPONSE_MODE=simulate   # simulate | kill
NET_MONITOR_TARGETS=         # "이름=host:port;..."
NET_MONITOR_INTERVAL=5       # 헬스체크 주기(초)
EDR_SCAN_INTERVAL=5          # EDR 프로세스 스캔 주기(초)
EDR_HOST_LABEL=              # 비우면 hostname 사용

# ── 알림 보존 ──
ALERT_RETENTION_DAYS=90
ALERT_ARCHIVE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
DATA_RETENTION_DAYS=30       # 파일 로그·리포트만 적용(DB와 분리)
DATA_RETENTION_INTERVAL_HOURS=6   # 보존 정리 루프 주기(시간)

# ── SOAR 자동 대응 ──
SOAR_BLOCK_MODE=simulate     # simulate | ufw | iptables
SOAR_AUTO_BLOCK=True
SOAR_APPROVAL_REQUIRED=True
SOAR_APPROVAL_TIMEOUT_MINUTES=15
SOAR_MIN_BLOCK_CONFIDENCE=95       # CRITICAL이어도 이 값 미만은 자동 차단 후보 제외
SOAR_REQUIRE_CORROBORATION=True    # Snort/평판/IoC 등 독립 근거 2개 이상 요구
INCIDENT_SAVE_DEBOUNCE_SECONDS=5
SOAR_BLOCK_TTL_HOURS=24
SOAR_BLOCK_ALLOWLIST=        # 절대 차단 금지 IP/대역 (사설·Tailscale 은 자동 보호)
SOAR_FIREWALL_HELPER=/usr/local/sbin/soc-ufw

# ── 취약점 패치 (Ansible) ──
PATCH_APPLY_ENABLED=False    # True 라야 실제 패치 적용(기본 dry-run)
ANSIBLE_TARGETS=             # "이름=user@host;..."
PATCH_PLAYBOOK_DIR=data/ansible   # 플레이북 저장 위치

# ── 웹 퍼징 (본인 서버만) ──
FUZZ_TARGETS=
FUZZ_RATE=5
FUZZ_MAX_REQUESTS=300
FUZZ_TIMEOUT=5               # 요청 타임아웃(초)
FUZZ_ALLOW_WRITE=False       # True 면 POST 등 쓰기 메서드도 시도
VULN_SCAN_PORTS=             # "22,80,443" (비우면 기본 포트셋)

# ── 푸시 알림 (ntfy) ──
NTFY_ENABLED=False
NTFY_TOPIC=
NTFY_MIN_SEVERITY=CRITICAL
NTFY_SERVER=https://ntfy.sh  # 자체 호스팅 시 변경
NTFY_TOKEN=                  # 인증이 필요한 서버용(선택)
NTFY_COOLDOWN=300            # 동일 알림 재전송 최소 간격(초)

# ── 일일 리포트 ──
REPORT_HOUR=8
REPORT_DIR=data/reports      # 리포트 산출물 위치

# ── 로깅 ──
# 전 모듈이 구조화 로깅을 쓴다(시각·레벨 포함, logs/soc.log 로 회전 저장).
LOG_LEVEL=INFO               # DEBUG|INFO|WARNING|ERROR
LOG_DIR=logs
LOG_FILE=soc.log
LOG_MAX_BYTES=5242880        # 5MB 마다 회전
LOG_BACKUP_COUNT=5

# ML 트래픽 피처 보존 기간(일) — 재학습 소스라 알림(90일)보다 길게 잡는다
ML_FEATURE_RETENTION_DAYS=180

# ── 알림 중복제거·억제 ──
DEDUP_ENABLED=True
DEDUP_WINDOW_SECONDS=300          # 중복 병합 윈도우(초)
DEDUP_STORM_THRESHOLD=20          # 60초 내 동일 핑거프린트 이 횟수 초과 시 스톰
DEDUP_STORM_WINDOW_SECONDS=60
DEDUP_STORM_SUMMARY_SECONDS=300
DEDUP_RETENTION_DAYS=90           # 억제·병합 이벤트 보관 기간
# 최초 1회 시드용 억제 규칙 "이름=유형:출발지접두:룰ID:사유; ..." (이후 DB/API 에서 편집)
DEDUP_SUPPRESS_RULES=

# ── 보안 (CORS / CSRF) ──
# 이 대시보드는 동일 출처 앱이라 CORS 가 필요 없다. 별도 출처 클라이언트가
# 있을 때만 쉼표로 명시한다. 비워두면 CORS 헤더를 아예 내보내지 않는다.
CORS_ORIGINS=
# 상태변경 요청(POST/PUT/DELETE)의 Origin/Referer 를 검증한다
CSRF_PROTECTION=True
# 보안 헤더 (CSP·X-Frame-Options·nosniff·Referrer-Policy·Permissions-Policy)
# 외부 라이브러리를 static/vendor/ 에 자체 호스팅하므로 CSP 는 'self' 로 좁혀져
# 있다. 주의: script-src 에는 'unsafe-inline' 이 남는다 — 인라인 핸들러 132개
# 때문이며, 따라서 CSP 가 XSS 스크립트 주입을 막지는 못한다.
SECURITY_HEADERS_ENABLED=True
CSP_REPORT_ONLY=False      # True 면 차단 대신 보고만 (출처 추가 시 영향 확인)
CSP_EXTRA_SOURCES=         # 추가 허용 출처 (공백 구분). 기본은 전부 'self'.
# 여러 주소로 접속한다면 추가 (예: http://100.64.140.27:5055,http://soc.local:5055)
CSRF_TRUSTED_ORIGINS=
# 세션 쿠키 SameSite — Strict 권장. 외부 링크로 진입해 로그인 유지가 필요하면 Lax
SESSION_COOKIE_SAMESITE=Strict
# HTTPS 에서만 쿠키 전송. Tailscale HTTP 접속이면 False 여야 로그인이 유지된다.
SESSION_COOKIE_SECURE=False
# 해시 스캔 허용 디렉터리 (쉼표 구분). 비우면 홈 디렉터리와 실행 디렉터리.
HASH_SCAN_ALLOWED_DIRS=

# 원격 명령 허용 목록 (비우면 조회 전용 기본 목록: uptime, df, systemctl status 등)
PATCH_COMMAND_ALLOWLIST=

# ── DB 보존 (인시던트 / SOAR 실행 이력) ──
# RESOLVED 인시던트만 대상. 진행 중(OPEN/INVESTIGATING/CONTAINED)은 지우지 않는다
INCIDENT_RETENTION_DAYS=365
# 차단 결정 재현 로그 — 자동 차단의 근거를 남긴다(차단하지 않은 결정도 기록)
BLOCK_DECISION_DB=data/block_decisions.db
BLOCK_DECISION_RETENTION_DAYS=365
# 마지막 활동 후 이 기간 조용하면 자동 종료(RESOLVED). 0 이면 비활성.
# 타임라인에 사유와 이전 상태를 남기며, 새 알림이 오면 새 인시던트로 다시 열린다.
INCIDENT_AUTO_RESOLVE_DAYS=30
# 종료된 SOAR 실행만 대상. 승인 대기·진행 중은 지우지 않는다
SOAR_EXECUTION_RETENTION_DAYS=90

# ── Claude API 호출 회복력 ──
# SDK 기본(타임아웃 10분 × 재시도 2회 = 최대 30분)은 단일 워커 큐에 너무 길다
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=1
# 연속 실패가 이 횟수를 넘으면 쿨다운 동안 호출을 멈추고 규칙 기반으로 대체
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN=300

# ── 동시 연결 상한 (스레드 고갈 방지) ──
# 허니팟은 외부 노출(0.0.0.0) 시 공격자가 마음껏 연결할 수 있다.
# 초과분은 접촉만 기록하고 즉시 끊는다 — 탐지 가치는 지키되 스레드는 묶는다.
HONEYPOT_MAX_CONNS=200
SYSLOG_MAX_CONNS=50

# ── SIEM 상관관계 분석 ──
# 이 값들은 siem_correlation 이 읽고 있었으나 config.py 에도 여기에도 없어
# 설정 자체가 불가능했다(AUDIT F-1 역방향).
SIEM_CORR_WINDOW=600          # 상관 윈도우(초)
SIEM_CORR_COOLDOWN=300        # 규칙별 재발화 간격(초)
SIEM_CORR_MULTIVECTOR=3       # 다중 벡터 최소 종류
SIEM_CORR_BRUTE=5             # 지속 브루트포스 최소 횟수
SIEM_CORR_DISTRIBUTED=6       # 분산 공격 최소 출발지 수

# ── 파일·DB 경로 (기본값으로 충분하며, 옮길 때만 지정) ──
AUDIT_DB=data/audit.db
WATCHLIST_DB=data/watchlist.db
MALICIOUS_HASH_DB=data/malicious_hashes.txt
# Windows Sysmon 이벤트 채널 (리눅스에서는 무시됨)
SYSMON_LOG_CHANNEL=Microsoft-Windows-Sysmon/Operational
